# Copy this file to .env and fill in your values. .env is gitignored; never commit it.

# From Clio: Settings -> Developer Applications -> your app
CLIO_KEY=your_app_key
CLIO_SECRET=your_app_secret
CLIO_REDIRECT_URI=http://127.0.0.1:8080/callback

# From the /oauth/token response (access token lasts 30 days, refresh token doesn't expire)
CLIO_TOKEN=your_access_token
CLIO_REFRESH_TOKEN=your_refresh_token

# The case to pull (number in the matter's URL in the Clio dashboard)
MATTER_ID=12345678
