# Copy to .env and fill in. .env is gitignored; never commit it.
# From Clio: Settings -> Developer Applications -> your app
CLIO_KEY=
CLIO_SECRET=
CLIO_REDIRECT_URI=http://127.0.0.1:8080/callback
# From the /oauth/token response (access token lasts 30 days; refresh token is used to renew it)
CLIO_TOKEN=
CLIO_REFRESH_TOKEN=
# Use https://eu.app.clio.com, https://ca.app.clio.com or https://au.app.clio.com outside the US
CLIO_BASE_URL=https://app.clio.com
# Optional: skip the lookup by name and pull this matter directly
MATTER_ID=
# Optional: path to tesseract.exe if it is not on PATH
TESSERACT_CMD=

# Jev triage (scripts/triage.py). Get a key at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
